{
  "info": {
    "name": "Northlight Academy",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folders in order. Create an environment with: baseUrl (http://localhost:8080), adminEmail, adminPassword (the ADMIN_EMAIL/ADMIN_PASSWORD you configured), studentEmail, studentPassword, instructorEmail, instructorPassword. Other variables (tokens, ids) are set by test scripts. Postman keeps the HttpOnly refresh cookie in its cookie jar."
  },
  "item": [
    {
      "name": "1 Auth",
      "item": [
        {
          "name": "Register student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Student\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login student (cookie jar keeps refresh cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"rememberMe\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', ()=>pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set('studentToken', j.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Refresh (rotates cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "NorthlightWeb"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ],
              "query": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', ()=>pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set('studentToken', j.accessToken);"
                ]
              }
            }
          ]
        },
