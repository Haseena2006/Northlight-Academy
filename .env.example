# Copy to .env and fill in. NEVER commit .env.
# Neon PostgreSQL JDBC connection. Include sslmode=require; use the host, database,
# username and password supplied by your Neon project.
DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_USERNAME=<neon-username>
DB_PASSWORD=<neon-password>
# At least 32 characters, random. Generate: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_of_48_plus_chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
# Initial admin (created only if no ADMIN exists). Password: 10+ chars, upper, lower, digit
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_Strong1
STORAGE_DIR=./uploads
FRONTEND_ORIGIN=http://localhost:5173
# true when served over HTTPS (production)
COOKIE_SECURE=false
# DEV ONLY: logs password-reset links to the server log (no email provider is configured)
DEV_LOG_RESET_LINKS=false
